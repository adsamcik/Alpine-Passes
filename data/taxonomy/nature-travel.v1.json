  "entityFamilies": [
    {
      "id": "discoverable_geography",
      "entityTypes": ["Place", "NaturalFeature", "ProtectedArea"],
      "purpose": "Named destinations, physical nature features, and designated areas."
    },
    {
      "id": "established_route_structure",
      "entityTypes": ["TrailRoute", "RouteStage", "RouteVariant", "TrailSegment"],
      "purpose": "Named routes, ordered stages, alternatives, and physical line segments."
    },
    {
      "id": "access_and_movement",
      "entityTypes": ["AccessPoint", "TransportConnection"],
      "purpose": "Entrances, trailheads, parking, transfers, stations, landings, and linked transport."
