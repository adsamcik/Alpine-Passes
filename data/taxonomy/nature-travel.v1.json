    "minimumGates": {
      "evidenceQuality": 0.6,
      "distinctiveness": 0.55,
      "accessFit": 0.45
    },
    "principle": "Obscurity alone is never positive evidence; unknown legal access reduces ranking and sensitive, private, or unsuitable technical records are ineligible."
