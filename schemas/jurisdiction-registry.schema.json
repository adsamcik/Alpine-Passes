{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itinera.example/schemas/jurisdiction-registry.schema.json",
  "title": "Itinera jurisdiction and coverage registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "assessedAt",
    "coverageResolution",
    "coverageStatuses",
    "dimensions",
    "coverageProfiles",
    "sourceProfiles",
    "jurisdictions"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "assessedAt": {"type": "string", "format": "date"},
    "coverageResolution": {"type": "string", "minLength": 1},
    "coverageStatuses": {
      "type": "array",
      "prefixItems": [
        {"const": "Verified broad coverage"},
        {"const": "Verified partial coverage"},
        {"const": "Source available but not yet ingested"},
        {"const": "Structurally supported but unpopulated"},
        {"const": "Unknown"},
        {"const": "Excluded, with reason"}
      ],
      "items": false,
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true
    },
    "dimensions": {
      "type": "array",
      "prefixItems": [
        {"const": "protected_areas"},
        {"const": "natural_features"},
        {"const": "established_trail_routes"},
        {"const": "trail_network"},
        {"const": "access_points"},
        {"const": "scenic_roads"},
        {"const": "transport_connections"},
        {"const": "dynamic_conditions"},
        {"const": "names_localization"},
        {"const": "accessibility"},
        {"const": "licensing_provenance"},
        {"const": "sensitive_location_controls"}
      ],
      "items": false,
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true
    },
    "coverageProfiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/coverageProfile"}
    },
    "sourceProfiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
        "uniqueItems": true
      }
    },
    "jurisdictions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/jurisdiction"}
    }
  },
  "$defs": {
    "coverageStatus": {
      "enum": [
        "Verified broad coverage",
        "Verified partial coverage",
        "Source available but not yet ingested",
        "Structurally supported but unpopulated",
        "Unknown",
        "Excluded, with reason"
      ]
    },
    "coverageProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protected_areas",
        "natural_features",
        "established_trail_routes",
        "trail_network",
        "access_points",
        "scenic_roads",
        "transport_connections",
        "dynamic_conditions",
        "names_localization",
        "accessibility",
        "licensing_provenance",
        "sensitive_location_controls"
      ],
      "properties": {
        "protected_areas": {"$ref": "#/$defs/coverageStatus"},
        "natural_features": {"$ref": "#/$defs/coverageStatus"},
        "established_trail_routes": {"$ref": "#/$defs/coverageStatus"},
        "trail_network": {"$ref": "#/$defs/coverageStatus"},
        "access_points": {"$ref": "#/$defs/coverageStatus"},
        "scenic_roads": {"$ref": "#/$defs/coverageStatus"},
        "transport_connections": {"$ref": "#/$defs/coverageStatus"},
        "dynamic_conditions": {"$ref": "#/$defs/coverageStatus"},
        "names_localization": {"$ref": "#/$defs/coverageStatus"},
        "accessibility": {"$ref": "#/$defs/coverageStatus"},
        "licensing_provenance": {"$ref": "#/$defs/coverageStatus"},
        "sensitive_location_controls": {"$ref": "#/$defs/coverageStatus"}
      }
    },
    "jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "parentId",
        "inScope",
        "overallStatus",
        "coverageProfile",
        "sourceProfile",
        "legacyInventoryPresent"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9-]{0,63}$"
        },
        "name": {"type": "string", "minLength": 1},
        "kind": {
          "enum": [
            "coverage_region",
            "eu_member_state",
            "eu_outermost_region",
            "eu_autonomous_region",
            "eu_special_city",
            "uk_nation",
            "us_state",
            "us_federal_district",
            "canada_province",
            "canada_territory",
            "japan_prefecture",
            "norway_package",
            "norway_special_package",
            "swiss_canton",
            "indigenous_authority",
            "protected_area_authority",
            "municipality",
            "other_subnational",
            "cross_border_region",
            "territorial_exclusion",
            "territorial_exclusion_group"
          ]
        },
        "parentId": {"type": ["string", "null"]},
        "inScope": {"type": "boolean"},
        "overallStatus": {"$ref": "#/$defs/coverageStatus"},
        "coverageProfile": {"type": "string", "minLength": 1},
        "sourceProfile": {"type": "string", "minLength": 1},
        "legacyInventoryPresent": {"type": "boolean"},
        "legacyInventoryStatus": {"$ref": "#/$defs/coverageStatus"},
        "caveats": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "discoveryUrls": {
          "type": "array",
          "items": {"type": "string", "format": "uri"},
          "uniqueItems": true
        },
        "exclusionReason": {"type": "string", "minLength": 1},
        "members": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"inScope": {"const": false}},
            "required": ["inScope"]
          },
          "then": {
            "required": ["exclusionReason"],
            "properties": {
              "overallStatus": {"const": "Excluded, with reason"},
              "coverageProfile": {"const": "excluded"}
            }
          }
        }
      ]
    }
  }
}
