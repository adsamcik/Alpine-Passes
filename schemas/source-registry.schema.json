{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itinera.example/schemas/source-registry.schema.json",
  "title": "Itinera data-source registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "dataUsePolicy", "sources"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "dataUsePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mitCodeBoundary",
        "zeroPaidRights",
        "publicationRules",
        "mediaRules"
      ],
      "properties": {
        "mitCodeBoundary": { "type": "string", "minLength": 1 },
        "zeroPaidRights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["licenceFees", "restrictiveRights", "unknownRights"],
          "properties": {
            "licenceFees": { "const": "prohibited" },
            "restrictiveRights": { "const": "prohibited" },
            "unknownRights": { "const": "fail_closed" }
          }
        },
        "publicationRules": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "publishableDisposition",
            "discoveryOnlyDispositions",
            "blockedDisposition",
            "prohibitions"
          ],
          "properties": {
            "publishableDisposition": { "const": "approved" },
            "discoveryOnlyDispositions": { "const": ["lead_only", "link_only"] },
            "blockedDisposition": { "const": "blocked" },
            "prohibitions": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        },
        "mediaRules": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "owner",
        "authorityTier",
        "jurisdictionIds",
        "themes",
        "homepage",
        "retrieval",
        "licence",
        "updateCadence",
        "authentication",
        "rateLimits",
        "schemaAssumptions",
        "knownGaps",
        "failureBehaviour",
        "lastSuccessfulRefresh",
        "publicationDisposition",
        "rightsCost",
        "approvedUses",
        "redistribution"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]+$"
        },
        "name": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "authorityTier": {
          "enum": [
            "official_law",
            "official_agency",
            "official_portal",
            "openstreetmap",
            "established_open_geodata",
            "structured_reference",
            "official_tourism",
            "trail_organisation",
            "manual_curation"
          ]
        },
        "jurisdictionIds": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        },
        "themes": {
          "type": "array",
          "items": {
            "enum": [
              "places",
              "names",
              "protected_areas",
              "trails",
              "access",
              "transport",
              "roads",
              "conditions",
              "closures",
              "hazards",
              "weather",
              "avalanche",
              "fire",
              "flood",
              "volcanic",
              "tide",
              "permits",
              "accessibility",
              "media",
              "prices"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "homepage": { "type": "string", "format": "uri" },
        "documentationUrl": { "type": ["string", "null"], "format": "uri" },
        "retrieval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "format", "snapshotPolicy"],
          "properties": {
            "method": {
              "enum": [
                "download",
                "api",
                "ogc_api",
                "wfs",
                "arcgis_rest",
                "sparql",
                "repository",
                "manual"
              ]
            },
            "format": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            },
            "endpoint": { "type": ["string", "null"], "format": "uri" },
            "snapshotPolicy": {
              "enum": [
                "retain_raw",
                "retain_content_hash_and_url",
                "reference_versioned_release",
                "manual_evidence_bundle"
              ]
            }
          }
        },
        "licence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "url", "attributionRequired", "shareAlike", "commercialUse"],
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "url": { "type": "string", "format": "uri" },
            "attributionRequired": { "type": "boolean" },
            "shareAlike": { "type": "boolean" },
            "commercialUse": { "enum": ["allowed", "prohibited", "unclear"] },
            "compatibilityNotes": { "type": "string" }
          }
        },
        "attribution": { "type": "string" },
        "updateCadence": { "type": "string" },
        "historicalAvailability": { "type": "string" },
        "authentication": {
          "type": "object",
          "required": ["required", "secretBrowserSafe"],
          "properties": {
            "required": { "type": "boolean" },
            "type": { "type": ["string", "null"] },
            "secretBrowserSafe": { "const": false }
          }
        },
        "rateLimits": { "type": "string" },
        "schemaAssumptions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "knownGaps": {
          "type": "array",
          "items": { "type": "string" }
        },
        "failureBehaviour": {
          "type": "object",
          "required": ["isolateSource", "serveLastKnownGood", "criticality"],
          "properties": {
            "isolateSource": { "const": true },
            "serveLastKnownGood": { "type": "boolean" },
            "criticality": { "enum": ["optional", "degraded", "blocking"] }
          }
        },
        "lastSuccessfulRefresh": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "publicationDisposition": {
          "enum": ["approved", "lead_only", "link_only", "blocked"]
        },
        "rightsCost": {
          "enum": ["no_fee", "paid", "unknown"]
        },
        "approvedUses": {
          "type": "array",
          "items": {
            "enum": [
              "discovery",
              "fact_evidence",
              "bulk_ingest",
              "geometry",
              "media",
              "runtime_api",
              "dynamic_status"
            ]
          },
          "uniqueItems": true
        },
        "governanceRationale": { "type": "string", "minLength": 1 },
        "redistribution": {
          "enum": ["allowed", "allowed_with_attribution", "restricted", "prohibited", "unclear"]
        },
        "contact": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "publicationDisposition": { "const": "approved" }
            },
            "required": ["publicationDisposition"]
          },
          "then": {
            "properties": {
              "approvedUses": { "minItems": 1 },
              "rightsCost": { "const": "no_fee" }
            }
          },
          "else": {
            "required": ["governanceRationale"]
          }
        },
        {
          "if": {
            "properties": {
              "publicationDisposition": { "const": "blocked" }
            },
            "required": ["publicationDisposition"]
          },
          "then": {
            "properties": {
              "approvedUses": { "maxItems": 0 }
            }
          }
        }
      ]
    }
  }
}
