    },
    {
      "id": "time_dependent_governance",
      "entityTypes": ["Condition", "Restriction", "PermitRequirement", "OpeningSchedule", "Price"],
      "purpose": "Current or scheduled state, legal and operational limits, permits, hours, and cost."
    },
    {
      "id": "safety",
      "entityTypes": ["Hazard"],
      "purpose": "Exposure, snow, glacier, tide, wildlife, remoteness, navigation, and other hazard evidence."
    },
    {
      "id": "evidence_and_presentation",
      "entityTypes": ["MediaAsset", "LocalizedName", "Source", "SourceAssertion", "Geometry", "QualityAssessment"],
      "purpose": "Traceable names, media, provenance, geometry, and uncertainty."
    },
    {
      "id": "territorial_authority",
      "entityTypes": ["Jurisdiction"],
      "purpose": "National, subnational, Indigenous, protected-area, municipal, and unusual territorial authority."
