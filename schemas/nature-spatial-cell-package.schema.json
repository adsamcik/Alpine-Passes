{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itinera.example/schemas/nature-spatial-cell-package.schema.json",
  "title": "Itinera nature spatial cell package",
  "description": "A deterministic content-addressed shard for one Web Mercator XYZ cell at fixed zoom 8.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactType",
    "generated",
    "cellId",
    "zoom",
    "x",
    "y",
    "shardIndex",
    "shardCount",
    "entities",
    "contentHash"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "artifactType": { "const": "nature-spatial-cell-package" },
    "generated": { "const": true },
    "cellId": {
      "type": "string",
      "pattern": "^8/(?:0|[1-9][0-9]{0,2})/(?:0|[1-9][0-9]{0,2})$"
    },
    "zoom": { "const": 8 },
    "x": { "type": "integer", "minimum": 0, "maximum": 255 },
    "y": { "type": "integer", "minimum": 0, "maximum": 255 },
    "shardIndex": { "type": "integer", "minimum": 0 },
    "shardCount": { "type": "integer", "minimum": 1 },
    "entities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "nature-domain.schema.json" }
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
